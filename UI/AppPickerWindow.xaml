<Window x:Class="Clipt.UI.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Clipt.Services"
        Title="Choose an app" Width="480" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource Bg.Settings}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="20,0,6,0">
                <TextBlock Text="Don't record copies from…" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg.Primary}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource IconBtn}" Width="40"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click" ToolTip="Close">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="11"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="20,4,20,10" CornerRadius="8" Background="{DynamicResource Bg.Control}"
                    BorderBrush="{DynamicResource Stroke.Control}" BorderThickness="1" Padding="12,0">
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource BareTextBox}"
                             FontSize="14" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="12,0,0,0" Text="Search apps" IsHitTestVisible="False"
                               FontSize="14" Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" Margin="12,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="AppList_DoubleClick">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Style="{StaticResource SlimScrollViewer}" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent" CornerRadius="7" Padding="10,7" Margin="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type s:AppEntry}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="24" Height="24" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Grid.Column="1" Margin="12,0,8,0" Text="{Binding Name}" FontSize="13.5"
                                           Foreground="{DynamicResource Fg.Primary}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                <TextBlock Grid.Column="2" Text="{Binding OriginLabel}" FontSize="11.5"
                                           Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LoadingText" Text="Finding your apps…" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource Fg.Tertiary}" />
            </Grid>

            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Stroke.Divider}" Padding="20,12">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="Browse…" Click="Browse_Click"
                            ToolTip="Pick a program file (.exe) yourself" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80" />
                        <Button x:Name="AddButton" Style="{StaticResource AccentBtn}" Content="Add" Click="Add_Click" MinWidth="80"
                                IsDefault="True" IsEnabled="False" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
