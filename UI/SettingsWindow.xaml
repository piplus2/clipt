<Window x:Class="Clipt.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Clipt.UI"
        Title="Clipt Settings" Width="600" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ui:BoolToVisibility x:Key="Vis" />
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Margin" Value="4,26,0,10" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="16,12" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
        </Style>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Tertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,16,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Stroke.Divider}" />
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Control}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Control}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource Bg.Settings}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Margin="18,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="Logo" Width="18" Height="18" Margin="0,0,10,0" />
                    <TextBlock Text="Clipt Settings" FontSize="12.5" Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource IconBtn}" Width="40"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click" ToolTip="Close">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="11"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,24">

                    <!-- ================= General ================= -->
                    <TextBlock Style="{StaticResource Section}" Text="General" Margin="4,8,0,10" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="Shortcut" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Opens Clipt from anywhere. Click the box and press a new combination." />
                                </StackPanel>
                                <TextBox x:Name="HotkeyBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Width="170"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="False" TextAlignment="Center"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="Take over Win + V" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Open Clipt instead of the built-in Windows clipboard history." />
                                </StackPanel>
                                <CheckBox x:Name="WinVSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="Paste directly" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Enter pastes into the app you were using. Off: Enter only copies." />
                                </StackPanel>
                                <CheckBox x:Name="PasteSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Start with Windows" VerticalAlignment="Center" />
                                <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Appearance" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="Theme" Content="System" />
                                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="Theme" Content="Dark" />
                                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="Theme" Content="Light" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ================= History ================= -->
                    <TextBlock Style="{StaticResource Section}" Text="History &amp; privacy" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="Keep clips for" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Days. 0 keeps them forever. Pinned clips are always kept." />
                                </StackPanel>
                                <TextBox x:Name="RetentionBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Width="90"
                                         TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Maximum clips" VerticalAlignment="Center" />
                                <TextBox x:Name="MaxItemsBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Width="90"
                                         TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Capture images" VerticalAlignment="Center" />
                                <CheckBox x:Name="ImagesSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="Search text inside images" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Uses the OCR built into Windows. Runs on your PC, nothing is uploaded." />
                                </StackPanel>
                                <CheckBox x:Name="OcrSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <StackPanel Orientation="Horizontal" Margin="16,12">
                                <Button Style="{StaticResource Btn}" Content="Open data folder" Click="OpenData_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource DangerBtn}" Content="Clear history…" Click="Clear_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ================= Privacy ================= -->
                    <TextBlock Style="{StaticResource Section}" Text="Privacy &amp; security" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="Protect passwords and secrets" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Recognises passwords, API keys, private keys, card and bank numbers. They're hidden, never searchable or sent to AI, and removed from the clipboard 30 seconds after you paste them." />
                                </StackPanel>
                                <CheckBox x:Name="DetectSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          Checked="Detect_Changed" Unchecked="Detect_Changed" />
                            </Grid>
                            <StackPanel x:Name="SensitivePanel">
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="When a secret is copied" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="SensitiveHide" Style="{StaticResource Segment}" GroupName="Sensitive"
                                                         Content="Keep briefly, hidden" Checked="Detect_Changed" />
                                            <RadioButton x:Name="SensitiveSkip" Style="{StaticResource Segment}" GroupName="Sensitive"
                                                         Content="Never save" Checked="Detect_Changed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel x:Name="TtlPanel">
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Style="{StaticResource RowGrid}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Label}" Text="Delete secrets after" />
                                            <TextBlock Style="{StaticResource Desc}" Text="Minutes since last use. Pin a secret (Ctrl+P) to keep it." />
                                        </StackPanel>
                                        <TextBox x:Name="TtlBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Width="90"
                                                 TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="Skip private browsing windows" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Edge InPrivate, Firefox, Brave and Opera private windows. (Chrome Incognito can't be detected.)" />
                                </StackPanel>
                                <CheckBox x:Name="PrivateWindowsSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="Hide Clipt when sharing your screen" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Clipt stays invisible in screen sharing (Teams, Zoom, Meet), recordings and screenshots." />
                                </StackPanel>
                                <CheckBox x:Name="CaptureSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />

                            <!-- Excluded apps -->
                            <StackPanel Margin="16,12,16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Label}" Text="Never record from these apps" />
                                        <TextBlock Style="{StaticResource Desc}" Text="Tip: right-click any clip in Clipt and choose “Never record from…”." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Btn}" Click="AddApp_Click" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="11" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Fg.Primary}" />
                                            <TextBlock Text="Add app" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="ExcludedList" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="15" Padding="10,0,2,0" Margin="0,0,6,6" Height="30"
                                                    Background="{DynamicResource Bg.Control}" BorderThickness="1"
                                                    BorderBrush="{DynamicResource Stroke.Divider}" ToolTip="{Binding Exe}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE737;" FontSize="12"
                                                                   Visibility="{Binding HasNoIcon, Converter={StaticResource Vis}}" />
                                                    </Grid>
                                                    <TextBlock Margin="8,0,2,0" VerticalAlignment="Center" FontSize="12.5"
                                                               Foreground="{DynamicResource Fg.Primary}" Text="{Binding Name}" />
                                                    <Button Style="{StaticResource IconBtn}" Width="24" Height="24" VerticalAlignment="Center"
                                                            ToolTip="Remove" Click="RemoveApp_Click" Tag="{Binding}">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="9"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Style="{StaticResource Desc}" Margin="16,10,16,12"
                                       Text="Your history is encrypted (AES-256) with a key only your Windows account can unlock. Password managers that mark their copies as private are always skipped." />
                        </StackPanel>
                    </Border>

                    <!-- ================= AI ================= -->
                    <TextBlock Style="{StaticResource Section}" Text="AI" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="AI actions" />
                                    <TextBlock Style="{StaticResource Desc}" Text="Press Tab on a clip to summarize, rewrite, translate, explain, or ask anything about it. A clip is sent only when you run an action on it." />
                                </StackPanel>
                                <CheckBox x:Name="AiSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          Checked="AiSwitch_Changed" Unchecked="AiSwitch_Changed" />
                            </Grid>

                            <StackPanel x:Name="AiPanel">
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Provider" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ProviderClaude" Style="{StaticResource Segment}" GroupName="Provider"
                                                         Content="Claude" Checked="Provider_Changed" />
                                            <RadioButton x:Name="ProviderOllama" Style="{StaticResource Segment}" GroupName="Provider"
                                                         Content="Ollama (local)" Checked="Provider_Changed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel x:Name="ClaudePanel">
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Style="{StaticResource RowGrid}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Label}" Text="Anthropic API key" />
                                            <TextBlock Style="{StaticResource Desc}">
                                                <Run Text="Stored encrypted for your Windows account. Get one at" />
                                                <Hyperlink NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Link_Navigate"
                                                           Foreground="{DynamicResource Accent}">console.anthropic.com</Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                        <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Style="{StaticResource FieldPasswordBox}" Width="220"
                                                     VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Style="{StaticResource RowGrid}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Label}" Text="Model" />
                                            <TextBlock Style="{StaticResource Desc}" Text="e.g. claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5" />
                                        </StackPanel>
                                        <TextBox x:Name="ClaudeModelBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Width="220"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="OllamaPanel">
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Style="{StaticResource RowGrid}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Label}" Text="Endpoint" />
                                            <TextBlock Style="{StaticResource Desc}" Text="Runs entirely on your machine." />
                                        </StackPanel>
                                        <TextBox x:Name="OllamaEndpointBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Width="220"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Style="{StaticResource RowGrid}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Label}" Text="Model" />
                                            <TextBlock Style="{StaticResource Desc}" Text="Use a vision model (e.g. llava, gemma3) for image actions." />
                                        </StackPanel>
                                        <TextBox x:Name="OllamaModelBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Width="220"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Translate to" VerticalAlignment="Center" />
                                    <TextBox x:Name="TranslateBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Width="220"
                                             VerticalAlignment="Center" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <StackPanel Orientation="Horizontal" Margin="16,12">
                                    <Button x:Name="TestButton" Style="{StaticResource Btn}" Content="Test connection" Click="Test_Click" />
                                    <TextBlock x:Name="TestResult" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg.Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="VersionText" Margin="4,20,0,0" FontSize="11.5" Foreground="{DynamicResource Fg.Tertiary}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Stroke.Divider}" Padding="28,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="90" />
                    <Button Style="{StaticResource AccentBtn}" Content="Save" Click="Save_Click" MinWidth="90" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
