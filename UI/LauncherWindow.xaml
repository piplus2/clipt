<Window x:Class="Clipt.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Clipt.UI"
        xmlns:m="clr-namespace:Clipt.Models"
        xmlns:s="clr-namespace:Clipt.Services"
        Title="Clipt" Width="820" Height="520"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ui:BoolToVisibility x:Key="Vis" />
        <ui:BoolToVisibility x:Key="NotVis" Invert="True" />

        <Style x:Key="ListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Style="{StaticResource SlimScrollViewer}" Focusable="False" Padding="0,6">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="Transparent" CornerRadius="8" Margin="8,1,6,1" Padding="9,5">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" Margin="-9,0,0,0"
                                        HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Hidden" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== List rows ===== -->
        <DataTemplate x:Key="ClipRow" DataType="{x:Type m:ClipItem}">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource Bg.Icon}"
                        Visibility="{Binding HasGlyph, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" />
                </Border>
                <Border Width="30" Height="30" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Stroke.Divider}"
                        Visibility="{Binding ShowThumbnail, Converter={StaticResource Vis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border Width="30" Height="30" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Stroke.Control}"
                        Background="{Binding ColorBrush}" Visibility="{Binding ShowColorSwatch, Converter={StaticResource Vis}}" />

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock ui:Highlighter.Query="{Binding DataContext.Query, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               ui:Highlighter.Text="{Binding Title}"
                               Foreground="{DynamicResource Fg.Primary}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Fg.Tertiary}" FontSize="11.5"
                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="12"
                           Foreground="{DynamicResource Accent}" Visibility="{Binding Pinned, Converter={StaticResource Vis}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionRow" DataType="{x:Type s:AiAction}">
            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource Bg.Icon}">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="13" />
                </Border>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Name}"
                           Foreground="{DynamicResource Fg.Primary}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!-- ===== Preview templates ===== -->
        <DataTemplate x:Key="TextPreview" DataType="{x:Type m:ClipItem}">
            <TextBox x:Name="T" Style="{StaticResource PreviewText}" Text="{Binding PreviewText, Mode=OneWay}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsShortText}" Value="True">
                    <Setter TargetName="T" Property="FontFamily" Value="{StaticResource DisplayFont}" />
                    <Setter TargetName="T" Property="FontSize" Value="22" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:ClipKind.Code}">
                    <Setter TargetName="T" Property="FontFamily" Value="{StaticResource MonoFont}" />
                    <Setter TargetName="T" Property="FontSize" Value="12.5" />
                    <Setter TargetName="T" Property="TextWrapping" Value="NoWrap" />
                    <Setter TargetName="T" Property="HorizontalScrollBarVisibility" Value="Auto" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LinkPreview" DataType="{x:Type m:ClipItem}">
            <StackPanel VerticalAlignment="Top">
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Bg.Icon}" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="20" />
                </Border>
                <TextBlock Text="{Binding LinkHost}" Margin="0,14,0,0" FontFamily="{StaticResource DisplayFont}"
                           FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}" TextTrimming="CharacterEllipsis" />
                <TextBox Style="{StaticResource PreviewText}" Margin="0,6,0,0" FontSize="12.5"
                         Foreground="{DynamicResource Fg.Secondary}" Text="{Binding Text, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Border Style="{StaticResource Kbd}">
                        <TextBlock Text="Ctrl O" FontSize="11" Foreground="{DynamicResource Fg.Secondary}" />
                    </Border>
                    <TextBlock Text="Open in browser" FontSize="12" Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ColorPreview" DataType="{x:Type m:ClipItem}">
            <StackPanel VerticalAlignment="Top">
                <Border Height="150" CornerRadius="14" Background="{Binding ColorBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource Stroke.Control}" />
                <TextBox Style="{StaticResource PreviewText}" Margin="0,16,0,0" FontFamily="{StaticResource MonoFont}"
                         FontSize="13" Text="{Binding ColorInfo, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ImagePreview" DataType="{x:Type m:ClipItem}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding HasOcrText, Converter={StaticResource Vis}}">
                    <TextBlock Text="TEXT IN IMAGE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Tertiary}" />
                    <TextBox Style="{StaticResource PreviewText}" MaxHeight="80" Margin="0,4,0,0" FontSize="12.5"
                             Foreground="{DynamicResource Fg.Secondary}" Text="{Binding OcrText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MaskedPreview" DataType="{x:Type m:ClipItem}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Bg.Icon}" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="22" Foreground="{DynamicResource Fg.Primary}" />
                </Border>
                <TextBlock Text="{Binding PreviewText}" Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="22"
                           Foreground="{DynamicResource Fg.Secondary}" />
                <TextBlock Text="{Binding SensitiveReason}" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13"
                           FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12" TextAlignment="Center"
                           Foreground="{DynamicResource Fg.Tertiary}" TextWrapping="Wrap" MaxWidth="320"
                           Text="Stored encrypted, kept out of search and AI, and wiped from the clipboard 30 s after pasting." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Border Style="{StaticResource Kbd}">
                        <TextBlock Text="Ctrl R" FontSize="11" Foreground="{DynamicResource Fg.Secondary}" />
                    </Border>
                    <TextBlock Text="Show" FontSize="12" Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Border Style="{StaticResource Kbd}">
                        <TextBlock Text="↵" FontSize="11" Foreground="{DynamicResource Fg.Secondary}" />
                    </Border>
                    <TextBlock Text="Paste without showing" FontSize="12" Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FilesPreview" DataType="{x:Type m:ClipItem}">
            <ScrollViewer Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Paths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{DynamicResource Fg.Primary}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource Bg.Overlay}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootShift" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Search bar ===== -->
            <Grid Grid.Row="0" Margin="24,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="18"
                           Visibility="{Binding IsBrowse, Converter={StaticResource Vis}}" />
                <TextBlock Text="✦" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}" Visibility="{Binding IsAi, Converter={StaticResource Vis}}" />

                <Grid Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource BareTextBox}" FontSize="21"
                             FontFamily="{StaticResource DisplayFont}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding Placeholder}" IsHitTestVisible="False" FontSize="21" Margin="2,0,0,0"
                               FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource Fg.Tertiary}"
                               Visibility="{Binding Query, Converter={StaticResource NotVis}}" />
                </Grid>

                <Border Grid.Column="2" CornerRadius="10" Padding="9,3" Margin="0,0,6,0" VerticalAlignment="Center"
                        Background="{DynamicResource Accent.Soft}" Visibility="{Binding IsAi, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding AiProvider}" FontSize="11.5" Foreground="{DynamicResource Fg.Primary}" />
                </Border>

                <Button Grid.Column="3" Style="{StaticResource IconBtn}" ToolTip="Settings (Ctrl+,)" Click="Settings_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="15"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <!-- ===== Filter chips ===== -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Filters}" Margin="20,0,20,10" Focusable="False"
                          Visibility="{Binding IsBrowse, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource Chip}" GroupName="Filters" Content="{Binding Name}"
                                     IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Background="{DynamicResource Stroke.Divider}" />

            <!-- ===== Body ===== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ClipList" Style="{StaticResource ListStyle}" ItemContainerStyle="{StaticResource Row}"
                         ItemTemplate="{StaticResource ClipRow}" ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}" SelectionChanged="List_SelectionChanged"
                         MouseDoubleClick="ClipList_DoubleClick"
                         Visibility="{Binding IsBrowse, Converter={StaticResource Vis}}">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="ClipMenu_Opened">
                            <MenuItem Header="Paste" InputGestureText="Enter" Click="Menu_Paste" />
                            <MenuItem Header="Paste as plain text" InputGestureText="Shift+Enter" Click="Menu_PastePlain" />
                            <MenuItem Header="Copy" InputGestureText="Ctrl+Enter" Click="Menu_Copy" />
                            <Separator />
                            <MenuItem x:Name="OpenMenuItem" Header="Open" InputGestureText="Ctrl+O" Click="Menu_Open" />
                            <MenuItem Header="Pin / Unpin" InputGestureText="Ctrl+P" Click="Menu_Pin" />
                            <MenuItem x:Name="AiMenuItem" Header="AI actions…" InputGestureText="Tab" Click="Menu_Ai" />
                            <Separator />
                            <MenuItem x:Name="RevealMenuItem" Header="Show content" InputGestureText="Ctrl+R" Click="Menu_Reveal" />
                            <MenuItem x:Name="SensitiveMenuItem" Header="Mark as sensitive" InputGestureText="Ctrl+H" Click="Menu_Sensitive" />
                            <MenuItem x:Name="ExcludeMenuItem" Header="Never record from this app" Click="Menu_ExcludeApp" />
                            <Separator />
                            <MenuItem Header="Delete" InputGestureText="Shift+Del" Click="Menu_Delete" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <ListBox x:Name="ActionList" Style="{StaticResource ListStyle}" ItemContainerStyle="{StaticResource Row}"
                         ItemTemplate="{StaticResource ActionRow}" ItemsSource="{Binding Actions}"
                         SelectedItem="{Binding SelectedAction}" SelectionChanged="List_SelectionChanged"
                         MouseDoubleClick="ActionList_DoubleClick"
                         Visibility="{Binding IsAi, Converter={StaticResource Vis}}" />

                <StackPanel Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="34" Foreground="{DynamicResource Fg.Tertiary}" />
                    <TextBlock Text="{Binding EmptyText}" Margin="0,14,0,0" FontSize="14" Foreground="{DynamicResource Fg.Secondary}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource Stroke.Divider}"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource NotVis}}" />

                <!-- Clip preview -->
                <Grid Grid.Column="2" Margin="22,18,20,12" Visibility="{Binding ShowClipPreview, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl Content="{Binding Selected}" Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource TextPreview}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selected.Kind}" Value="{x:Static m:ClipKind.Link}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource LinkPreview}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Selected.Kind}" Value="{x:Static m:ClipKind.Color}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ColorPreview}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Selected.Kind}" Value="{x:Static m:ClipKind.Image}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ImagePreview}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Selected.Kind}" Value="{x:Static m:ClipKind.Files}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource FilesPreview}" />
                                    </DataTrigger>
                                    <!-- Last, so it wins over the kind-specific templates. -->
                                    <DataTrigger Binding="{Binding Selected.IsMasked}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource MaskedPreview}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="16" Height="16" Margin="0,0,7,0" Source="{Binding Selected.AppIcon}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Grid.Column="1" Text="{Binding Selected.SourceApp}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Selected.Details}" FontSize="12"
                                   Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>

                <!-- AI result -->
                <Grid Grid.Column="2" Margin="22,18,20,12" Visibility="{Binding IsAiResult, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✦" FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding AiTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="400" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource PreviewText}" Text="{Binding AiOutput, Mode=OneWay}" />
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="ThinkingText" Text="Thinking…" FontSize="12" Foreground="{DynamicResource Fg.Tertiary}"
                                   Visibility="{Binding AiBusy, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding AiError}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Danger}"
                                   Visibility="{Binding AiError, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Stroke.Divider}" Padding="18,9,18,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11.5"
                               Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Hints}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:Hint}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                    <Border Style="{StaticResource Kbd}">
                                        <TextBlock Text="{Binding Keys}" FontSize="11" Foreground="{DynamicResource Fg.Secondary}" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource Fg.Tertiary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
